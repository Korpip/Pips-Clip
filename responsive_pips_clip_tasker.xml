			<Int sr="arg2" val="0"/>
			<Int sr="arg3" val="0"/>
			<Int sr="arg4" val="0"/>
			<Int sr="arg5"/>
		</Action>
		
		<!-- Set %DESIGNW = 1080 -->
		<Action sr="act2" ve="7">
			<code>547</code>
			<Str sr="arg0" ve="3">%DESIGNW</Str>
			<Str sr="arg1" ve="3">1080</Str>
			<Int sr="arg2" val="0"/>
			<Int sr="arg3" val="0"/>
			<Int sr="arg4" val="0"/>
			<Int sr="arg5"/>
		</Action>
		
		<!-- Set %SCALE = %SW / %DESIGNW (Do Maths) -->
		<Action sr="act3" ve="7">
			<code>549</code>
			<Str sr="arg0" ve="3">%SCALE</Str>
			<Str sr="arg1" ve="3">%SW / %DESIGNW</Str>
			<Int sr="arg2" val="0"/>
		</Action>
		
		<!-- Set %W = (%SW * 80) / 100 (Do Maths) -->
		<Action sr="act4" ve="7">
			<code>549</code>
			<Str sr="arg0" ve="3">%W</Str>
			<Str sr="arg1" ve="3">(%SW * 80) / 100</Str>
			<Int sr="arg2" val="0"/>
		</Action>
		
		<!-- Set %H = (%SH * 50) / 100 (Do Maths) -->
		<Action sr="act5" ve="7">
			<code>549</code>
			<Str sr="arg0" ve="3">%H</Str>
			<Str sr="arg1" ve="3">(%SH * 50) / 100</Str>
			<Int sr="arg2" val="0"/>
		</Action>
		
		<!-- Set %X = (%SW - %W) / 2 (Do Maths) -->
		<Action sr="act6" ve="7">
			<code>549</code>
			<Str sr="arg0" ve="3">%X</Str>
			<Str sr="arg1" ve="3">(%SW - %W) / 2</Str>
			<Int sr="arg2" val="0"/>
		</Action>
		
		<!-- Set %Y = 10 -->
		<Action sr="act7" ve="7">
			<code>547</code>
			<Str sr="arg0" ve="3">%Y</Str>
			<Str sr="arg1" ve="3">10</Str>
			<Int sr="arg2" val="0"/>
			<Int sr="arg3" val="0"/>
			<Int sr="arg4" val="0"/>
			<Int sr="arg5"/>
		</Action>
	</Task>
	
